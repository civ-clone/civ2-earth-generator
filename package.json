{
  "name": "@civ-clone/civ2-earth-generator",
  "version": "0.1.0",
  "main": "index.js",
  "description": "Civilization II's own Earth, as a world Generator, in its three sizes: the terrain, rivers, map seed and start positions derived from the original's .MP files, on the staggered isometric grid.",
  "repository": "git@github.com:civ-clone/civ2-earth-generator.git",
  "keywords": [
    "typescript",
    "civilization"
  ],
  "author": "dom111 <dom111@users.noreply.github.com>",
  "license": "MIT",
  "private": false,
  "scripts": {
    "build": "npm run ts:compile && npm run prettier:format",
    "generate": "ts-node tools/generate.ts",
    "prettier:check": "prettier --config .prettierrc --check '**/*.ts'",
    "prettier:format": "prettier --config .prettierrc '**/*.ts' --write",
    "test": "ts-mocha ./tests/*.test.ts",
    "ts:compile": "tsc --build tsconfig.json"
  },
  "devDependencies": {
    "@types/chai": "^4.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^16.0.0",
    "chai": "^4.0.0",
